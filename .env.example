# 맛집 브리핑 시크릿 예시
#
# Supabase 에서는 이 파일을 직접 읽지 않는다. 아래 값들을 `supabase secrets set` 으로
# 등록한다 (docs/SUPABASE.md 참고). 로컬에서 `supabase start` 로 띄울 때는
# supabase/.env 로 복사해두면 Edge Function 이 읽는다.

# 필수 — 카카오 장소·블로그 검색
KAKAO_REST_API_KEY=

# 블로그 요약. 없으면 카카오맵 메뉴판 기준으로만 표시된다
GEMINI_API_KEY=

# Gemini 무료 한도 소진 시 폴백 (선택)
GROQ_API_KEY=

# 지도 보기 (선택). 카카오 개발자 콘솔에 배포 도메인 등록 필요
KAKAO_JS_KEY=

# 접속 암호 (선택이지만 공개 URL 이면 사실상 필수).
# 설정하지 않으면 Edge Function 이 공개 상태가 되어 API 무료 한도가 도용될 수 있다.
APP_PASSWORD=

# 내 저장 맛집 — 네이버지도 공유 링크. 쉼표 또는 공백으로 구분 (선택)
MY_PLACE_LINKS=

# 배포 스크립트용 (시크릿 아님, 셸 환경변수)
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
